# ── Django Core ───────────────────────────────────────────────
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ───────────────────────────────────────────────────
# Local SQLite (default — no DATABASE_URL needed for local dev)
# DATABASE_URL=sqlite:///db.sqlite3

# PostgreSQL for production (Render provides this automatically)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Email ──────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=michaeltadessemiki@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password

# ── CORS & CSRF ────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# ── Production security (set to True on Render) ────────────────
SECURE_SSL_REDIRECT=False

# ── Admin account (auto-created on Render deploy) ──────────────
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=michaeltadessemiki@gmail.com
DJANGO_SUPERUSER_PASSWORD=admin123

# ── Cloudinary (required for persistent uploads on Render) ─────
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret
